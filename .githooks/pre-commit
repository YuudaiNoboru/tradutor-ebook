#!/bin/sh
set -e

# Obter arquivos Python (.py) em stage (Added, Copied, Modified, Renamed)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)

if [ -z "$STAGED_PY_FILES" ]; then
    exit 0
fi

echo "==> Executando checagens de pre-commit nos arquivos staged..."

echo "-> ruff check..."
if ! hatch run ruff check $STAGED_PY_FILES; then
    echo "❌ Erro no linter (ruff check). Execute 'hatch run lint --fix' ou corrija os erros acima."
    exit 1
fi

echo "-> ruff format --check..."
if ! hatch run ruff format --check $STAGED_PY_FILES; then
    echo "❌ Erro de formatação (ruff format). Execute 'hatch run fmt' para formatar o código."
    exit 1
fi

echo "-> mypy..."
if ! hatch run mypy $STAGED_PY_FILES; then
    echo "❌ Erro de tipagem estática (mypy). Corrija as inconsistências de tipo apontadas acima."
    exit 1
fi

echo "✅ Todas as checagens de pre-commit passaram!"
